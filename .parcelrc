{
  "extends": "@parcel/config-default",
  "resolvers": ["parcel-resolver-website", "..."],
  "transformers": {
    "src/blog/**/*.md": [
      {
        "plugin": "@parcel/transformer-markdown",
        "config": {
          "layout": "src/_includes/blog-layout.html",
          "gfm": true,
          "title": true,
          "description": true,
          "anchors": true
        }
      }
    ],
    "fragment:*.md": [
      {
        "plugin": "@parcel/transformer-markdown",
        "config": {
          "gfm": true
        }
      }
    ],
    "*.md": [
      {
        "plugin": "@parcel/transformer-markdown",
        "config": {
          "layout": "src/_includes/layout.html",
          "gfm": true,
          "title": true,
          "description": true,
          "toc": true,
          "anchors": true
        }
      }
    ],
    "*.html": [
      {
        "plugin": "@parcel/transformer-html",
        "config": {
          "macros": {
            "code-sample": "src/_includes/samples.mjs#sample",
            "code-migration": "src/_includes/samples.mjs#migration",
            "code-file": "src/_includes/samples.mjs#file",
            "code-tabs": "src/_includes/samples.mjs#codeTabs",
            "api-name": "src/_includes/samples.mjs#apiName",
            "pre": "src/_includes/highlight.mjs#pre",
            "table": "src/_includes/tables.mjs#table"
          }
        }
      }
    ],
    "*.css": [
      "@parcel/transformer-tailwind",
      {
        "plugin": "@parcel/transformer-css",
        "config": {
          "pseudoClasses": {
            "focusVisible": "focus-visible"
          }
        }
      }
    ]
  },
  "namers": ["parcel-namer-website", "..."]
}
