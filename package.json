{
  "name": "parcel-website",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "browserslist": [
    "last 2 Safari versions",
    "last 2 Chrome versions",
    "last 2 Firefox versions"
  ],
  "scripts": {
    "build": "rm -rf dist; parcel build src/home/index.html src/docs.html src/blog/index.html src/plugin-browser/index.html 'src/**/*.md'",
    "start": "parcel serve src/home/index.html src/docs.html src/blog/index.html src/plugin-browser/index.html 'src/**/*.md'",
    "lint": "oxfmt 'generate-api-docs/*.js' 'src/**/*.{js,json,md,css}'",
    "generate-api-docs": "node generate-api-docs/ ../parcel ./api"
  },
  "devDependencies": {
    "@babel/parser": "^7.20.1",
    "lefthook": "latest",
    "oxfmt": "latest",
    "parcel": "^3.0.0-alpha.3",
    "prismjs": "^1.26.0",
    "tailwindcss": "^4.3.5",
    "tailwindcss-safe-area": "^1.3.0"
  },
  "dependencies": {
    "@alpinejs/intersect": "^3.10.5",
    "alpinejs": "^3.10.5",
    "marked": "^2.0.7",
    "preact": "^10.5.0"
  }
}
