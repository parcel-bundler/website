{
  "name": "parcel-website",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "browserslist": [
    "last 2 Safari versions",
    "last 2 Chrome versions",
    "last 2 Firefox versions"
  ],
  "scripts": {
    "build": "rm -rf _site dist; eleventy; parcel build src/home/index.html '_site/*.html' _site/*/index.html '_site/*/*/*.html' --public-url $(node public-url.js)",
    "watch": "eleventy --watch",
    "serve": "parcel serve src/home/index.html '_site/*.html' _site/*/index.html '_site/*/*/*.html'",
    "start": "run-p watch serve",
    "debug": "DEBUG=* eleventy",
    "lint": "prettier --write 'generate-api-docs/*.js' 'src/**/*.{js,json,md,css}'",
    "generate-api-docs": "node generate-api-docs/ ../parcel ./api",
    "generate-api-docs:watch": "nodemon -w ../parcel/packages-v3/plugin/src -w generate-api-docs -e js,ts -x yarn generate-api-docs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^1.0.2",
    "@11ty/eleventy-navigation": "^0.3.5",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^4.1.0",
    "@babel/generator": "^7.20.1",
    "@babel/parser": "^7.20.1",
    "@babel/traverse": "^7.20.1",
    "@parcel/transformer-posthtml": "next",
    "eleventy-plugin-toc": "^1.1.0",
    "flow-bin": "^0.177.0",
    "husky": "^4.3.6",
    "lint-staged": "^10.5.3",
    "markdown-it": "^12.0.4",
    "markdown-it-anchor": "^8.0.1",
    "nodemon": "^2.0.6",
    "npm-run-all": "^4.1.5",
    "nullthrows": "^1.1.1",
    "parcel": "^3.0.0-alpha.2",
    "posthtml": "^0.16.6",
    "posthtml-include": "^1.7.0",
    "posthtml-prism": "^1.0.4",
    "posthtml-urls": "^1.0.0",
    "prettier": "2.7.1",
    "process": "^0.11.10",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.3.5",
    "tailwindcss-safe-area": "^1.3.0"
  },
  "dependencies": {
    "@alpinejs/intersect": "^3.10.5",
    "alpinejs": "^3.10.5",
    "focus-visible": "^5.2.0",
    "marked": "^2.0.7",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-use": "^17.3.1"
  },
  "resolutions": {
    "gulp-sass": "5.0.0",
    "posthtml-prism@^1.0.4": "patch:posthtml-prism@npm%3A1.0.4#./.yarn/patches/posthtml-prism-npm-1.0.4-1df296f883.patch"
  },
  "lint-staged": {
    "*.{md,css,js,json}": "prettier --write"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "alias": {
    "./assets/**": "./src/assets/$1",
    "./plugin-browser/**": "./src/plugin-browser/$1"
  }
}
